# USDM4-Assure / conversion API - environment template.
# Copy to `.env` (git-ignored) and fill in. Never commit real keys.

# --- LLM pipeline (required: it is the default path) -----------------------------------------
# OpenRouter is the gateway for every model role (see config/models.yaml).
OPEN_ROUTER_KEY=

# Optional: direct Anthropic fallback when no OpenRouter key is set.
ANTHROPIC_API_KEY=

# Optional: override the model of one role, e.g. USDM4_MODEL_EXTRACT=anthropic/claude-sonnet-5.5
# Roles: EXTRACT, EXTRACT_ALT, VERIFY, VISION, VISION_ALT, HARD_REASONING, ROUTE
# USDM4_MODEL_EXTRACT=

# --- Conversion API (src/usdm4_api) ------------------------------------------------------------
# Comma-separated keys; clients send `X-API-Key`. Leave empty only on a private network:
# with no key the API is open to anyone who can reach it.
USDM4_API_KEYS=

# Conversions run at once (others wait), upload limit in MB, per-request timeout in seconds.
USDM4_MAX_CONCURRENT=2
USDM4_MAX_UPLOAD_MB=60
USDM4_TIMEOUT_S=900

# The API is LLM-only: without OPEN_ROUTER_KEY it answers 503 and never returns a thin result.

# --- Optional ----------------------------------------------------------------------------------
# Official CDISC CORE conformance gate (free key from the CDISC Library); used with `--core`.
CDISC_LIBRARY_API_KEY=
# Set to 1 to run that CORE gate on every API conversion (result goes in the report, never blocks).
USDM4_RUN_CORE=
# Seconds a finished async job's result is kept in memory.
USDM4_JOB_TTL_S=3600

# Where the audit trail and the LLM cache live (defaults: data/audit, data/cache/llm.sqlite).
# Mount these on a persistent volume in a container.
# USDM4_AUDIT_DIR=
# USDM4_CACHE_PATH=

# Force the deterministic path even when a key is present (debugging only).
# USDM4_NO_LLM=1
